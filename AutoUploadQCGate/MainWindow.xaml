<Window x:Class="AutoUploadQCGate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoUploadQCGate"
        mc:Ignorable="d"
        Title="Auto Upload QC Gate" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Style for buttons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for status indicators -->
        <Style x:Key="StatusSuccess" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StatusError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F44336"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="StatusProcessing" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9800"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Style for judgement indicators -->
        <Style x:Key="JudgementPass" TargetType="Border">
            <Setter Property="Background" Value="#E8F5E8"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <Style x:Key="JudgementFail" TargetType="Border">
            <Setter Property="Background" Value="#FFEBEE"/>
            <Setter Property="BorderBrush" Value="#F44336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <!-- Khai báo Converters trong Resources -->
        <local:JudgementToStyleConverter x:Key="JudgementToStyleConverter"/>
        <local:JudgementToColorConverter x:Key="JudgementToColorConverter"/>
        <local:StatusToStyleConverter x:Key="StatusToStyleConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20,15" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="40" Height="40" Fill="#2196F3"/>
                    <TextBlock Text="Auto Upload QC Gate" FontSize="22" FontWeight="Bold" Foreground="#333333" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⚙️ Settings" Style="{StaticResource ModernButton}" Background="#607D8B"
                         Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Control Panel -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File Selection -->

                <!-- Action Buttons -->
                <Button x:Name="btnStartScan" Grid.Column="2" Content="▶️ Start Auto Upload" Style="{StaticResource ModernButton}" Background="#4CAF50" Margin="0,0,10,0" Click="btnStartScan_Click"/>
                <Button x:Name="btnStopScan" Grid.Column="3" Content="⏹️ Stop" Style="{StaticResource ModernButton}" Background="#F44336" Click="btnStopScan_Click"/>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Grid Header -->
                <Border Grid.Row="0" Background="#F8F9FA" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="2.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Combine Indication" FontWeight="Bold" Foreground="#333333" Margin="15,12"/>
                        <TextBlock Grid.Column="1" Text="Upload Quantity" FontWeight="Bold" Foreground="#333333" Margin="15,12,0,12" HorizontalAlignment="Left" Width="100"/>
                        <TextBlock Grid.Column="2" Text="Log" FontWeight="Bold" Foreground="#333333" Margin="15,12"/>
                        <TextBlock Grid.Column="3" Text="Judgement" FontWeight="Bold" Foreground="#333333" Margin="15,12"/>
                        <TextBlock Grid.Column="4" Text="Status" FontWeight="Bold" Foreground="#333333" Margin="15,12"/>
                        <TextBlock Grid.Column="5" Text="Uploaded At" FontWeight="Bold" Foreground="#333333" Margin="15,12"/>
                    </Grid>
                </Border>

                <!-- Data List (Virtualizing ItemsControl) -->
                <ItemsControl x:Name="DataList" Grid.Row="1" Margin="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <Border BorderThickness="{TemplateBinding BorderThickness}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    Background="{TemplateBinding Background}">
                                <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#F0F0F0" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="2.5*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Combine Indication -->
                                    <TextBlock Grid.Column="0" Text="{Binding CombineIndication}" Margin="15,10" VerticalAlignment="Center" Foreground="#333333"/>

                                    <!-- Upload Quantity -->
                                    <TextBlock Grid.Column="1" Text="{Binding UploadQuantity}" Margin="15,10" VerticalAlignment="Center" Foreground="#666666" HorizontalAlignment="Center"/>

                                    <!-- Log -->
                                    <TextBlock Grid.Column="2" Text="{Binding Log}" Margin="15,10" VerticalAlignment="Center" Foreground="#666666" TextWrapping="Wrap"/>

                                    <!-- Judgement -->
                                    <Border Grid.Column="3" Margin="10,5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Style="{Binding Judgement, Converter={StaticResource JudgementToStyleConverter}}">
                                        <TextBlock Text="{Binding Judgement}" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   FontWeight="SemiBold" Foreground="{Binding Judgement, Converter={StaticResource JudgementToColorConverter}}"/>
                                    </Border>

                                    <!-- Status -->
                                    <TextBlock Grid.Column="4" Text="{Binding Status}" Margin="15,10" VerticalAlignment="Center" 
                                               Style="{Binding Status, Converter={StaticResource StatusToStyleConverter}}"/>

                                    <!-- Uploaded At -->
                                    <TextBlock Grid.Column="5" Text="{Binding UploadedAt}" Margin="15,10" VerticalAlignment="Center" Foreground="#666666"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📈 Total Records:" Foreground="#666666" Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtTotalRecords" Text="0" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,15,0"/>

                    <TextBlock Text="✅ Successful:" Foreground="#666666" Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtOKRecords" Text="0" FontWeight="SemiBold" Foreground="#4CAF50" Margin="0,0,15,0"/>

                    <TextBlock Text="❌ Failed:" Foreground="#666666" Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtNGRecords" Text="0" FontWeight="SemiBold" Foreground="#F44336" Margin="0,0,15,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"/>
            </Grid>
        </Border>
    </Grid>
</Window>