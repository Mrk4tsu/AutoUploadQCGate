<Application x:Class="AutoUploadQCGate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Judgement Styles -->
        <SolidColorBrush x:Key="JudgementPass" Color="#C8E6C9"/>
        <!-- Màu xanh nhạt -->
        <SolidColorBrush x:Key="JudgementFail" Color="#FFCDD2"/>
        <!-- Màu đỏ nhạt -->

        <!-- Status Styles -->
        <SolidColorBrush x:Key="StatusSuccess" Color="#A5D6A7"/>
        <!-- Thành công -->
        <SolidColorBrush x:Key="StatusError" Color="#EF9A9A"/>
        <!-- Lỗi -->
        <SolidColorBrush x:Key="StatusProcessing" Color="#FFF59D"/>
        <!-- Đang xử lý -->
    </Application.Resources>
</Application>
