<Window x:Class="AutoUploadQCGate.PasswordInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Password"
        Height="201"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA"
        WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="42.04"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" Height="64">
            <TextBlock Text="Please enter application password:" 
                       FontWeight="SemiBold" 
                       Foreground="#333" 
                       Margin="0,0,0,10" Height="17" />
            <PasswordBox x:Name="PasswordBoxInput"
                         FontSize="12"
                         Padding="10"
                         BorderThickness="1"
                         BorderBrush="#E0E0E0"
                         Background="White" />

            <TextBlock x:Name="ErrorText"
                       Foreground="Red"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"
                       Text="Incorrect password!" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Width="170">
            <Button Content="OK" Width="80" Margin="0,0,10,0"
                    Background="#2196F3" Foreground="White" 
                    BorderThickness="0" Cursor="Hand"
                    Click="OkButton_Click" />
            <Button Content="Cancel" Width="80"
                    Background="#F44336" Foreground="White" 
                    BorderThickness="0" Cursor="Hand"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
