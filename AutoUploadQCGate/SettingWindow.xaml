<Window x:Class="AutoUploadQCGate.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoUploadQCGate"
        mc:Ignorable="d"
        Title="Settings - Auto Upload QC Gate" 
        Height="696" 
        Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Style for buttons -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for section headers -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Style for labels -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style for text boxes -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Style for numeric up down -->
        <Style x:Key="ModernNumericBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- Style for combo box -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Style for toggle switch -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" 
                BorderThickness="1" BorderBrush="#E0E0E0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="30" Height="30" Fill="#2196F3"/>
                <TextBlock Text="Application Settings" FontSize="18" FontWeight="Bold" 
                          Foreground="#333333" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Application Password Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" 
                        BorderThickness="1" BorderBrush="#E0E0E0">
                    <StackPanel>
                        <TextBlock Text="🔐 Application Password" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Password:" 
                                      Style="{StaticResource SettingLabel}" Margin="0,0,15,10"/>
                            <TextBox x:Name="PasswordValidationText" Grid.Row="0" Grid.Column="1" 
        Style="{StaticResource ModernTextBox}" Text=""
        Margin="0,0,10,10"/>

                        </Grid>

                    </StackPanel>
                </Border>
                <!-- General Settings Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" 
        BorderThickness="1" BorderBrush="#E0E0E0">
                    <StackPanel>
                        <TextBlock Text="🧩 General Settings" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Combine Log Path -->
                            <TextBlock Grid.Column="0" Text="Combine log path local:" 
                       Style="{StaticResource SettingLabel}" Margin="0,0,15,0"/>
                            <TextBox x:Name="CombineLogPathTextBox" 
                     Grid.Column="1" 
                     Style="{StaticResource ModernTextBox}" 
                     Text="C:\Logs\Combined"
                     Margin="0,0,10,0"/>
                            <Button Grid.Column="2" 
                    Content="Browse..." 
                    Style="{StaticResource ModernButton}" 
                    Width="80" 
                    Click="BrowseCombineLogPath_Click"/>

                            <!-- Combine Log Path -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Combine log path server:" 
                              Style="{StaticResource SettingLabel}" Margin="0,15,15,0"/>
                                                        <TextBox x:Name="CombineLogPathServerTextBox" 
                             Grid.Column="1" 
                                                                 Grid.Row="2"
                             Style="{StaticResource ModernTextBox}" 
                             Text="C:\Logs\Combined"
                             Margin="0,15,10,0"/>
                                                        <Button Grid.Column="2" 
                                                                Grid.Row="2"
                            Content="Browse..." 
                            Style="{StaticResource ModernButton}" 
                            Width="80" 
                                                                Margin="0,15,0,0"
                            Click="BrowseCombineLogServerPath_Click"/>

                            <!-- Combine Log Path -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Primary key file path:" 
   Style="{StaticResource SettingLabel}" Margin="0,15,15,0"/>
                            <TextBox x:Name="PrimaryKeyFilePathTextBox" 
                                  Grid.Column="1" 
                                                                      Grid.Row="3"
                                  Style="{StaticResource ModernTextBox}" 
                                  Text="C:\Logs\Combined"
                                  Margin="0,15,10,0"/>
                                                            <Button Grid.Column="2" 
                                                                     Grid.Row="3"
                                 Content="Browse..." 
                                 Style="{StaticResource ModernButton}" 
                                 Width="80" 
                                                                     Margin="0,15,0,0"
                                 Click="BrowsePrimaryKeyFilePathPath_Click"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Proxy host:" 
Style="{StaticResource SettingLabel}" Margin="0,15,15,0"/>
                            <TextBox x:Name="ProxyHost" 
                               Grid.Column="1" 
                                                                   Grid.Row="4"
                               Style="{StaticResource ModernTextBox}" 
                               Text="C:\Logs\Combined"
                               Margin="0,15,10,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Proxy port:" 
Style="{StaticResource SettingLabel}" Margin="0,15,15,0"/>
                            <TextBox x:Name="ProxyPort" 
                               Grid.Column="1" 
                                    
                                                          Grid.Row="5"
                               Style="{StaticResource ModernTextBox}" 
                               Text="C:\Logs\Combined"
                               Margin="0,15,10,10"/>
                            <CheckBox x:Name="CheckUseProxyCheckBox" Grid.Row="6" 
                                       Grid.ColumnSpan="3"
                                      Grid.Column="1"
                                     Content="Use proxy"
                                     VerticalAlignment="Center"/>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Scan Settings Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" 
                        BorderThickness="1" BorderBrush="#E0E0E0">
                    <StackPanel>
                        <TextBlock Text="⏰ Scan Settings" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Scan Interval(ms):" 
                                      Style="{StaticResource SettingLabel}" Margin="0,0,15,10"/>
                            <TextBox x:Name="ScanIntervalTextBox" Grid.Row="0" Grid.Column="1" 
                                    Style="{StaticResource ModernTextBox}" Text="30"
                                    PreviewTextInput="NumberValidationTextBox" Margin="0,0,10,10"/>

                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Startup Settings Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" 
                        BorderThickness="1" BorderBrush="#E0E0E0">
                    <StackPanel>
                        <TextBlock Text="🚀 Startup Settings" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="RunWithWindowsCheckBox" Grid.Column="0" 
                                     Content="Run with Windows startup"
                                     Style="{StaticResource ToggleSwitch}" 
                                     VerticalAlignment="Center" Width="200" Margin="0,0,15,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Automatically start application when Windows starts" 
                                          Style="{StaticResource SettingLabel}" FontWeight="Normal"/>
                                <TextBlock x:Name="StartupStatusText" FontSize="11" 
                                          Foreground="#666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Database Settings Section -->
                <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" 
        BorderThickness="1" BorderBrush="#E0E0E0">
                    <StackPanel>
                        <TextBlock Text="🗄️ Database Settings" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Server -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server:" 
                      Style="{StaticResource SettingLabel}" Margin="0,0,15,10"/>
                            <TextBox x:Name="ServerTextBox" Grid.Row="0" Grid.Column="1" 
                    Style="{StaticResource ModernTextBox}" Text="localhost"
                    Margin="0,0,10,10"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="" Style="{StaticResource SettingLabel}"/>

                            <!-- Port -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Port:" 
                      Style="{StaticResource SettingLabel}" Margin="0,0,15,10"/>
                            <TextBox x:Name="PortTextBox" Grid.Row="1" Grid.Column="1" 
                    Style="{StaticResource ModernTextBox}" Text="1433"
                    PreviewTextInput="NumberValidationTextBox" Margin="0,0,10,10"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="" Style="{StaticResource SettingLabel}"/>

                            <!-- Username -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Username:" 
                      Style="{StaticResource SettingLabel}" Margin="0,0,15,10"/>
                            <TextBox x:Name="UsernameTextBox" Grid.Row="2" Grid.Column="1" 
                    Style="{StaticResource ModernTextBox}" Text="sa"
                    Margin="0,0,10,10"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="" Style="{StaticResource SettingLabel}"/>

                            <!-- Password -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" 
                      Style="{StaticResource SettingLabel}" Margin="0,0,15,10"/>
                            <PasswordBox x:Name="DbPasswordBox" Grid.Row="3" Grid.Column="1" 
                        Padding="10,8" BorderThickness="1" BorderBrush="#E0E0E0"
                        Background="White" FontSize="14" Margin="0,0,10,10"/>

                            <!-- Database Name -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Database:" 
                      Style="{StaticResource SettingLabel}" Margin="0,0,15,0"/>
                            <TextBox x:Name="DatabaseNameTextBox" Grid.Row="4" Grid.Column="1" 
                    Style="{StaticResource ModernTextBox}" Text="QCGateDB"
                    Margin="0,0,10,0"/>
                        </Grid>

                        <TextBlock x:Name="DbConnectionStatusText" Margin="0,10,0,0" 
                  FontWeight="SemiBold" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <!-- Additional Settings Section -->
                <Border Background="White" CornerRadius="8" Padding="20" 
                        BorderThickness="1" BorderBrush="#E0E0E0">
                    <StackPanel>
                        <TextBlock Text="⚙️ Additional Settings" Style="{StaticResource SectionHeader}"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="AutoStartScanCheckBox" Grid.Row="0" 
                                     Content="Auto start scanning when application launches"
                                     VerticalAlignment="Center" Margin="0,0,0,10"/>

                            <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Row="1" 
                                     Content="Minimize to system tray when closed"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,15,0,0" 
                BorderThickness="1" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Content="💾 Save" Style="{StaticResource ModernButton}" 
                       Click="SaveSettings_Click" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="❌ Cancel" Style="{StaticResource ModernButton}" 
                       Background="#F44336" Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>